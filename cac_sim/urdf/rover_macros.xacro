<?xml version="1.0"?>
<!-- Small reusable macros shared by the rover component files. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Uniform-density solid box, origin at its center; x/y/z are full side lengths. -->
  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass/12.0*(y*y+z*z)}" ixy="0" ixz="0"
        iyy="${mass/12.0*(x*x+z*z)}" iyz="0"
        izz="${mass/12.0*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Uniform-density solid cylinder whose axis is the inertial frame's Z.
       Pass the same rpy as the cylinder <geometry> origin so the axial moment
       lands on the cylinder's real axis. -->
  <xacro:macro name="cylinder_inertial" params="mass radius length rpy:='0 0 0'">
    <inertial>
      <origin xyz="0 0 0" rpy="${rpy}"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass/12.0*(3*radius*radius+length*length)}" ixy="0" ixz="0"
        iyy="${mass/12.0*(3*radius*radius+length*length)}" iyz="0"
        izz="${mass/2.0*radius*radius}"/>
    </inertial>
  </xacro:macro>

  <!-- Hide a rover link's visual(s) from the LiDAR only. See "LIDAR
       SELF-DETECTION FILTER" in rover_properties.xacro. -->
  <xacro:macro name="lidar_self_filter" params="link">
    <gazebo reference="${link}">
      <visual>
        <visibility_flags>${self_filter_flags}</visibility_flags>
      </visual>
    </gazebo>
  </xacro:macro>

  <!-- Keep a fixed-jointed child as its own link in the URDF->SDF conversion.
       By default SDFormat lumps fixed children into their parent, which renames
       any sensor's published frame_id after the lumped root instead of its own
       link (found by testing: scans came back with frame_id
       "cac_rover/base_footprint/lidar_sensor" instead of "lidar_link", which
       slam_toolbox/Nav2 could never resolve). -->
  <xacro:macro name="keep_fixed_joint" params="joint">
    <gazebo reference="${joint}">
      <disableFixedJointLumping>true</disableFixedJointLumping>
    </gazebo>
  </xacro:macro>

</robot>
